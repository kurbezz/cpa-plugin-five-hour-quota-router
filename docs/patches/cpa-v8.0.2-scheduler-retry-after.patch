+++ b/internal/pluginhost/rpc_retry_after_test.go
@@ -0,0 +1,62 @@
+package pluginhost
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+)
+
+func TestCallPluginRetryAfter(t *testing.T) {
+	for _, tc := range []struct{ value, want string }{
+		{"17", "17"}, {"9223372036", "9223372036"}, {"", ""}, {"null", ""}, {"0", ""}, {"-1", ""},
+		{"9223372037", ""}, {"9223372036854775808", ""}, {`"17"`, ""}, {"17.0", ""}, {"1.5", ""}, {"true", ""}, {"{}", ""}, {"[]", ""},
+	} {
+		t.Run("value="+tc.value, func(t *testing.T) {
+			raw := `{"ok":false,"error":{"code":"quota","message":"exhausted","http_status":429`
+			if tc.value != "" {
+				raw += `,"retry_after_seconds":` + tc.value
+			}
+			raw += "}}"
+			_, err := callPlugin[rpcEmptyResponse](context.Background(), staticEnvelopePluginClient{raw: []byte(raw)}, pluginabi.MethodSchedulerPick, rpcEmptyResponse{})
+			var carrier interface {
+				StatusCode() int
+				RetryAfterSeconds() int64
+			}
+			if !errors.As(err, &carrier) {
+				t.Fatalf("missing narrow contract: %T %v", err, err)
+			}
+			if carrier.StatusCode() != 429 || err.Error() != "exhausted" {
+				t.Fatalf("lost status/message: %v", err)
+			}
+			if got := coreauth.SafeResponseHeaders(fmt.Errorf("wrapped: %w", err)).Get("Retry-After"); got != tc.want {
+				t.Fatalf("Retry-After = %q, want %q", got, tc.want)
+			}
+			if !isPluginErrorEnvelope([]byte(raw)) {
+				t.Fatal("error envelope not recognized")
+			}
+		})
+	}
+}
+
+func TestDecodeEnvelopeResultRetryAfterBounds(t *testing.T) {
+	for _, seconds := range []int64{0, -1, 17, 9223372036, 9223372037} {
+		t.Run(fmt.Sprint(seconds), func(t *testing.T) {
+			_, err := decodeEnvelopeResult[rpcEmptyResponse](pluginabi.Envelope{Error: &pluginabi.Error{HTTPStatus: 429, RetryAfterSeconds: &seconds}})
+			var carrier interface{ RetryAfterSeconds() int64 }
+			if !errors.As(err, &carrier) {
+				t.Fatalf("missing retry carrier: %v", err)
+			}
+			want := int64(0)
+			if seconds > 0 && seconds <= 9223372036 {
+				want = seconds
+			}
+			if got := carrier.RetryAfterSeconds(); got != want {
+				t.Fatalf("seconds=%d want=%d", got, want)
+			}
+		})
+	}
+}
