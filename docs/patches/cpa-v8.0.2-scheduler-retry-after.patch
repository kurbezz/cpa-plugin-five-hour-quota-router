+)
+
+func TestErrorRetryAfterJSON(t *testing.T) {
+	max := int64(math.MaxInt64) / int64(time.Second)
+	for _, tc := range []struct {
+		name, value string
+		want        bool
+	}{
+		{"omitted", "", false}, {"null", "null", false}, {"positive", "17", true},
+		{"maximum", fmt.Sprint(max), true}, {"zero", "0", false}, {"negative", "-1", false},
+		{"duration_overflow", fmt.Sprint(max + 1), false}, {"integer_overflow", "9223372036854775808", false},
+		{"string", `"17"`, false}, {"float", "17.0", false}, {"fraction", "1.5", false},
+		{"bool", "true", false}, {"object", "{}", false}, {"array", "[]", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			raw := `{"code":"quota","message":"exhausted","http_status":429`
+			if tc.value != "" {
+				raw += `,"retry_after_seconds":` + tc.value
+			}
+			raw += "}"
+			var e Error
+			if err := json.Unmarshal([]byte(raw), &e); err != nil {
+				t.Fatalf("optional metadata broke decoding: %v", err)
+			}
+			if e.HTTPStatus != 429 || e.Message != "exhausted" {
+				t.Fatalf("lost status/message: %+v", e)
+			}
+			out, err := json.Marshal(e)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := strings.Contains(string(out), `"retry_after_seconds":`); got != tc.want {
+				t.Fatalf("metadata presence = %t, want %t: %s", got, tc.want, out)
+			}
+			if tc.want && !strings.Contains(string(out), `"retry_after_seconds":`+tc.value) {
+				t.Fatalf("delay changed: %s", out)
+			}
+		})
+	}
+}
+
+func TestErrorRetryAfterPointerEncodingAndReuse(t *testing.T) {
+	seconds := int64(17)
+	e := Error{Code: "quota", Message: "exhausted", HTTPStatus: 429, RetryAfterSeconds: &seconds}
+	raw, err := json.Marshal(e)
+	if err != nil || !strings.Contains(string(raw), `"retry_after_seconds":17`) {
+		t.Fatalf("optional pointer encoding: %s %v", raw, err)
+	}
+	if err := json.Unmarshal([]byte(`{"code":"quota","message":"exhausted","http_status":429}`), &e); err != nil {
+		t.Fatal(err)
+	}
+	if e.RetryAfterSeconds != nil {
+		t.Fatal("omitted metadata retained old pointer")
+	}
+	for _, value := range []string{"null", `"17"`, "17.0", "0", "-1", "9223372037"} {
+		t.Run("reuse="+value, func(t *testing.T) {
+			e.RetryAfterSeconds = &seconds
+			raw := `{"http_status":429,"retry_after_seconds":` + value + `}`
+			if err := json.Unmarshal([]byte(raw), &e); err != nil {
+				t.Fatal(err)
+			}
+			if e.RetryAfterSeconds != nil || e.HTTPStatus != 429 {
+				t.Fatalf("invalid optional metadata retained pointer or lost status: %+v", e)
+			}
+		})
+	}
+	if err := json.Unmarshal([]byte(`{"http_status":"429","retry_after_seconds":"bad"}`), &e); err == nil {
+		t.Fatal("tolerant optional decoding must not weaken status decoding")
+	}
+	for _, raw := range []string{
+		`{"code":17,"retry_after_seconds":"bad"}`,
+		`{"message":true,"retry_after_seconds":"bad"}`,
+		`{"retryable":"true","retry_after_seconds":"bad"}`,
+	} {
+		if err := json.Unmarshal([]byte(raw), &e); err == nil {
+			t.Fatalf("existing fields must remain strict: %s", raw)
+		}
+	}
+}
