+			router := gin.New()
+			router.POST("/v1/messages", NewClaudeCodeAPIHandler(base).ClaudeMessages)
+			req := httptest.NewRequest(http.MethodPost, "/v1/messages", strings.NewReader(fmt.Sprintf(`{"model":%q,"max_tokens":1,"messages":[{"role":"user","content":"hi"}],"stream":%t}`, model, stream)))
+			req.Header.Set("Content-Type", "application/json")
