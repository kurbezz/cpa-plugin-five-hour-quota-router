+func TestSafeResponseHeadersPluginRetryAfterStatusOverride(t *testing.T) {
+	for _, status := range []int{500, 403} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			err := pluginStatusOverrideError{status: status, cause: pluginRetryError{429, 17}}
+			if got := SafeResponseHeaders(err).Get("Retry-After"); got != "" {
+				t.Fatalf("outer status %d must suppress inner 429 retry header, got %q", status, got)
+			}
+		})
+	}
+	if got := SafeResponseHeaders(fmt.Errorf("outer: %w", pluginRetryError{429, 17})).Get("Retry-After"); got != "17" {
+		t.Fatalf("plain wrapping lost 429 retry header: %q", got)
+	}
+}
+
+func TestSafeResponseHeadersPluginRetryAfter(t *testing.T) {
+	max := int64(math.MaxInt64) / int64(time.Second)
+	for _, tc := range []struct {
+		status  int
+		seconds int64
+		want    string
+	}{
+		{429, 17, "17"}, {429, max, fmt.Sprint(max)}, {429, 0, ""}, {429, -1, ""},
+		{429, max + 1, ""}, {429, math.MaxInt64, ""}, {500, 17, ""}, {403, 17, ""},
+	} {
+		for _, wrapped := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%d/%d/wrapped=%t", tc.status, tc.seconds, wrapped), func(t *testing.T) {
+				var err error = pluginRetryError{tc.status, tc.seconds}
+				if wrapped {
+					err = fmt.Errorf("outer: %w", err)
+				}
+				h := SafeResponseHeaders(err)
+				if got := h.Get("Retry-After"); got != tc.want {
+					t.Fatalf("got %q want %q", got, tc.want)
+				}
+				if len(h) > 1 {
+					t.Fatalf("unexpected headers: %v", h)
+				}
+			})
+		}
+	}
+}
diff --git a/sdk/pluginabi/error_json.go b/sdk/pluginabi/error_json.go
new file mode 100644
index 0000000..3a66cb2
--- /dev/null
+++ b/sdk/pluginabi/error_json.go
@@ -0,0 +1,28 @@
+package pluginabi
+
+import (
+	"encoding/json"
+	"math"
+	"time"
+)
+
+// UnmarshalJSON treats invalid optional retry metadata as absent, without
+// weakening decoding of the existing error fields or losing HTTPStatus.
+func (e *Error) UnmarshalJSON(data []byte) error {
+	type plainError Error
+	var decoded plainError
+	wire := struct {
+		*plainError
+		RetryAfter json.RawMessage `json:"retry_after_seconds"`
+	}{plainError: &decoded}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	var seconds int64
+	if len(wire.RetryAfter) > 0 && json.Unmarshal(wire.RetryAfter, &seconds) == nil &&
+		seconds > 0 && seconds <= math.MaxInt64/int64(time.Second) {
+		decoded.RetryAfterSeconds = &seconds
+	}
+	*e = Error(decoded)
+	return nil
+}
