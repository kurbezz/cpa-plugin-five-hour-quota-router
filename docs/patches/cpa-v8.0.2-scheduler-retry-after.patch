+	seconds int64
+}
+
+func (e pluginRetryError) Error() string            { return "quota" }
+func (e pluginRetryError) StatusCode() int          { return e.status }
+func (e pluginRetryError) RetryAfterSeconds() int64 { return e.seconds }
